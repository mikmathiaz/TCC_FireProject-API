# ==========================================
# Fire Watcher — Configurações de Ambiente
# ==========================================

# Ambiente de execução (development | production | test)
ENVIRONMENT=development

# Configurações do Backend (FastAPI)
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./data/fire_watcher.db

# Google Earth Engine (ID do projeto Google Cloud com a API habilitada)
# Deixe vazio caso esteja utilizando dados locais de simulação
GEE_PROJECT_ID=

# APIs Complementares
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Configurações do Frontend (Streamlit)
BACKEND_API_URL=http://127.0.0.1:8000
